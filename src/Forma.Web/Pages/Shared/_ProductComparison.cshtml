<section id="product-comparison" class="forma-section">
  <div class="forma-container">

    <div class="mx-auto mb-12 max-w-3xl text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-forma-lime">
        Interactive Demo / 05
      </span>

      <h2 class="mt-5 font-display text-4xl font-bold md:text-6xl">
        Compare smarter.
        <span class="text-forma-lime">Choose better.</span>
      </h2>

      <p class="mt-5 text-forma-muted">
        Explore nutrition information and compare
        illustrative grocery prices in one place.
      </p>
    </div>

    <div id="products-widget" class="mx-auto max-w-6xl" aria-busy="true">

      <div class="mb-6 flex flex-wrap items-end justify-between gap-5">

        <div>
          <h3 class="font-display text-2xl font-bold">
            Product explorer
          </h3>
          <p class="mt-2 text-sm text-forma-muted">
            Filter, sort and compare products.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">

          <div>
            <label for="products-category" class="mb-2 block text-xs text-forma-muted">
              Category
            </label>

            <select id="products-category"
                    class="rounded-xl border border-forma-border bg-forma-surface px-4 py-3 text-sm text-white">
              <option value="all">All categories</option>
            </select>
          </div>

          <div>
            <label for="products-sort" class="mb-2 block text-xs text-forma-muted">
              Sort by
            </label>

            <select id="products-sort"
                    class="rounded-xl border border-forma-border bg-forma-surface px-4 py-3 text-sm text-white">
              <option value="name">Product name</option>
              <option value="price">Lowest package price</option>
              <option value="calories">Lowest calories</option>
            </select>
          </div>

        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">

        <div class="min-w-0 lg:col-span-2">

          <div id="products-list" class="grid gap-4 sm:grid-cols-2">
            <p class="text-forma-muted">
              Loading demonstration products...
            </p>
          </div>

        </div>

        <aside class="forma-card min-w-0 lg:col-span-1">

          <div class="flex items-center justify-between gap-3">
            <span class="text-xs font-semibold uppercase tracking-widest text-forma-lime">
              Comparison
            </span>

            <span id="products-selected-count" class="rounded-full border border-forma-border px-3 py-1 text-xs">
              0 / 2
            </span>
          </div>

          <h3 class="mt-4 font-display text-2xl font-bold">
            Side by side.
          </h3>

          <p class="mt-3 text-sm text-forma-muted">
            Select up to two products to inspect
            their best demo offers.
          </p>

          <div id="products-comparison-result" class="mt-8 space-y-4">
          </div>

          <p class="mt-6 border-t border-forma-border pt-5 text-xs leading-relaxed text-forma-muted">
            Price per 100 g allows comparison of
            package costs. Different foods are not
            necessarily nutritionally equivalent.
          </p>
        </aside>

      </div>

      <p id="products-notice" class="mt-6 text-xs leading-relaxed text-forma-muted">
      </p>

      <p id="products-status" role="status" aria-live="polite" class="mt-4 text-sm text-forma-muted">
        Loading product data...
      </p>

      <p id="products-error" role="alert" class="mt-3 hidden text-sm text-red-400">
      </p>

      <button id="products-retry" type="button" class="forma-btn-secondary mt-4 hidden">
        Try again
      </button>

    </div>
  </div>
</section>
