<section id="body-progress" class="forma-section px-6">
  <div class="forma-container">

    <div class="mx-auto mb-12 max-w-3xl text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-forma-lime">
        Interactive Demo / 02
      </span>

      <h2 class="mt-5 font-display text-4xl font-bold md:text-6xl">
        See your
        <span class="text-forma-lime">progress.</span>
      </h2>

      <p class="mt-5 text-forma-muted">
        Explore a visual comparison experience
        designed for tracking personal milestones.
      </p>
    </div>

    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2">

      <!-- Comparison -->
      <div class="forma-card">
        <div class="mb-5 flex items-center justify-between gap-4">
          <h3 class="font-display text-xl font-bold">
            Progress Comparison
          </h3>
          <span class="text-xs text-forma-lime">
            DEMO
          </span>
        </div>

        <div id="progress-comparison" class="progress-comparison" style="--comparison: 50%;">

          <!-- Before layer -->
          <div class="progress-scene progress-before">
            <div class="progress-figure">
              <span class="progress-figure-head"></span>
              <span class="progress-figure-body"></span>
            </div>

            <span class="progress-scene-label">
              BEFORE
            </span>
          </div>

          <!-- After layer -->
          <div class="progress-scene progress-after">
            <div class="progress-figure">
              <span class="progress-figure-head"></span>
              <span class="progress-figure-body"></span>
            </div>

            <span class="progress-scene-label">
              AFTER
            </span>
          </div>

          <!-- Divider -->
          <div class="progress-divider" aria-hidden="true">
            <span class="progress-divider-handle">
              ↔
            </span>
          </div>

          <!-- Accessible range input -->
          <input id="progress-slider" class="progress-range" type="range" min="0" max="100" value="50" step="1"
                 aria-label="Reveal before and after progress illustration" aria-describedby="progress-description" />
        </div>

        <div class="mt-5 flex items-center justify-between text-sm text-forma-muted">
          <span>Before</span>
          <output id="progress-value" for="progress-slider">
            50% revealed
          </output>
          <span>After</span>
        </div>

        <p id="progress-description" class="mt-5 text-xs leading-relaxed text-forma-muted">
          Illustrative comparison only. No personal photographs
          are uploaded, analyzed, or stored.
        </p>
      </div>

      <!-- Information -->
      <div>
        <span class="text-xs font-semibold uppercase tracking-widest text-forma-lime">
          Your journey, visualized
        </span>

        <h3 class="mt-5 font-display text-3xl font-bold md:text-4xl">
          Every milestone matters.
        </h3>

        <p class="mt-6 leading-relaxed text-forma-muted">
          The future FORMA app is designed to help
          you compare visual milestones and understand
          your progress over time.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          <div class="forma-card !p-5">
            <p class="font-display text-2xl font-bold text-forma-lime">
              12
            </p>
            <p class="mt-2 text-xs text-forma-muted">
              Demo weeks
            </p>
          </div>

          <div class="forma-card !p-5">
            <p class="font-display text-2xl font-bold text-forma-lime">
              8
            </p>
            <p class="mt-2 text-xs text-forma-muted">
              Demo milestones
            </p>
          </div>

          <div class="forma-card !p-5">
            <p class="font-display text-2xl font-bold text-forma-lime">
              100%
            </p>
            <p class="mt-2 text-xs text-forma-muted">
              Your journey
            </p>
          </div>
        </div>

        <p class="mt-6 text-xs text-forma-muted">
          All statistics are fictional demonstration values.
        </p>
      </div>

    </div>
  </div>
</section>
